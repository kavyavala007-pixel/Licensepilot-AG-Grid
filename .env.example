# Copy this file to .env. Keep credentials local; never paste them into chat or commit them.
# Without PayPal and Anthropic credentials the app runs in demo mode.
# NEVER commit .env to git.

# ── PayPal Sandbox ────────────────────────────────────────────────────────────
# Get these from: https://developer.paypal.com > Apps & Credentials > Create App
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=

# Get this after registering a webhook at: developer.paypal.com > Webhooks
# Register the webhook URL only after approving a public tunnel.
PAYPAL_WEBHOOK_ID=

# ── Anthropic (AI) ────────────────────────────────────────────────────────────
# Get from: https://console.anthropic.com
ANTHROPIC_API_KEY=

# Which Claude model to use (optional, defaults to claude-sonnet-4-6)
AI_MODEL=claude-sonnet-4-6

# ── Database ──────────────────────────────────────────────────────────────────
# SQLite for local dev (default). Switch to postgresql://... for production.
DATABASE_URL=file:./dev.db

# ── Server ────────────────────────────────────────────────────────────────────
PORT=3001

# Public URL of the app (used for PayPal subscription redirect URLs)
APP_URL=http://127.0.0.1:5173
